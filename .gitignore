.DS_Store
node_modules/
dist/

# Local environment. .env.example stays tracked.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Local score database and backups
data/
backups/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite.partial
*.db
*.bak

# Terraform (keep terraform.tfvars.example tracked).
# .terraform.lock.hcl is committed for each root (linux_amd64, darwin_arm64,
# darwin_amd64). Dependabot's terraform entry updates those lock files.
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
terraform.tfvars
*.auto.tfvars

# S3 backend settings. The bucket name is account-specific.
# backend.hcl.example stays tracked.
backend.hcl

# Private keys. The EC2 key stays in ~/.ssh and must not be copied in.
*.pem
*.key

*.retry
