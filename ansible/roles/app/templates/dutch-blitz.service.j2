[Unit]
Description=Dutch Blitz score tracker
After=network.target

[Service]
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_root }}
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/dutch-blitz/env
ExecStart={{ app_root }}/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
# Home is the app tree. Leave it readable. The database directory is the write path.
ProtectHome=false
PrivateTmp=true
ReadWritePaths={{ db_dir }}

[Install]
WantedBy=multi-user.target
