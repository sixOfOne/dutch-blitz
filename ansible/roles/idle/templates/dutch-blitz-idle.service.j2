[Unit]
Description=Warn, back up, and shut down when this Dutch Blitz host is idle or past its maximum uptime
After=network-online.target

[Service]
Type=oneshot
# The backup upload is the slow part. A short timeout would kill it
# halfway and leave the host up with no email.
TimeoutStartSec=15min
ExecStart=/usr/local/bin/dutch-blitz-idle check
