# Idle shutdown. No secrets and no email address. SNS has the address.
# The topic name plus the account id from the instance metadata is the ARN.
IDLE_WARN_MINUTES={{ idle_warn_minutes }}
IDLE_SHUTDOWN_MINUTES={{ idle_shutdown_minutes }}
UPTIME_WARN_MINUTES={{ uptime_warn_minutes | default(idle_uptime_warn_minutes) }}
UPTIME_SHUTDOWN_MINUTES={{ uptime_shutdown_minutes | default(idle_uptime_shutdown_minutes) }}
IDLE_SNOOZE_MINUTES={{ idle_snooze_minutes }}
IDLE_CHECK_MINUTES={{ idle_check_minutes }}
AWS_DEFAULT_REGION={{ aws_region | default(idle_aws_region) }}
AWS_REGION={{ aws_region | default(idle_aws_region) }}
IDLE_TOPIC_NAME={{ idle_topic_name }}
IDLE_ACCESS_LOG={{ idle_access_log }}
IDLE_ACTIVITY_PATH={{ activity_path | default(idle_activity_path) }}
IDLE_STATE_PATH={{ idle_state_dir }}/state.json
IDLE_PUBLIC_URL=https://{{ app_hostname }}
