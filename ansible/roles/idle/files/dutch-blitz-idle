#!/bin/bash
# Idle and uptime check, or a root-only snooze.
# The timer runs `check`. A person at the table runs `snooze` over SSH.
# There is no URL that does either one.
set -euo pipefail
set -a
# shellcheck disable=SC1091
. /etc/dutch-blitz/idle.env
set +a
export PYTHONPATH=/opt/dutch-blitz/hostpkg
exec /opt/dutch-blitz/venv/bin/python -m dutch_blitz_host.idle "$@"
