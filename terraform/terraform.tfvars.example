# Copy to terraform/terraform.tfvars (gitignored) and edit.
# With no tfvars file, enable_aws stays false and apply creates nothing.
# Leave enable_aws true until after `down`. Setting it false makes `down`
# skip the instance, because the destroy command reads this file.

enable_aws         = true
aws_region         = "us-east-2"
key_name           = "neo-atari"
ssh_ingress_cidr   = "203.0.113.10/32"
# Public IPs of every machine that runs `up` or `down`, each as a /32.
# Leave the list empty when only one machine opens SSH. Both operators
# keep this list identical. State is shared, so a different value on one
# machine rewrites the security group the other is using.
ssh_ingress_cidrs  = []
# Public keys for ec2-user, besides the neo-atari key pair. Empty leaves
# user_data unset. Each entry is one ssh-ed25519 or ssh-rsa line. Both
# operators keep the same list.
# extra_ssh_public_keys = ["ssh-ed25519 AAAA... bot@host"]
extra_ssh_public_keys = []
instance_type      = "t3.small"
root_volume_gb     = 8
backup_bucket_name = "dutch-blitz-scores-replace-me"
domain             = ""
acme_email         = ""

# Leave dns_zone_name empty to keep the sslip.io hostname and create no
# DNS records. These two lines publish an A record in the existing public
# zone and remove it on down. The zone, its NS/SOA, and the Clerk CNAMEs
# are not managed here.
dns_zone_name   = "sixofonedev.com"
dns_record_name = "blitz"

# Idle shutdown. The host checks itself. These defaults warn at 60 minutes
# idle or 7 hours up, and shut down at 90 minutes idle or 8 hours up.
# The timer runs every 15 minutes. Replace alerts@example.com before apply.
# The real address stays in this gitignored file. Apply terraform/game-role
# and confirm the SNS email once. See the README.
alert_email              = "alerts@example.com"
idle_warn_minutes        = 60
idle_shutdown_minutes    = 90
uptime_warn_minutes      = 420
uptime_shutdown_minutes  = 480
idle_snooze_minutes      = 120
idle_check_minutes       = 15
