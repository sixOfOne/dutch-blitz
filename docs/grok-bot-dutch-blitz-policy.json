{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeEc2InUsEast2",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "RunTaggedGameInstanceAndVolume",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:instance/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}",
          "aws:RequestTag/Project": "dutch-blitz"
        }
      }
    },
    {
      "Sid": "RunInstancesOnSupportingResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:network-interface/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:subnet/*",
        "arn:aws:ec2:${aws_region}::image/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:image/*",
        "arn:aws:ec2:${aws_region}::snapshot/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:key-pair/${key_name}"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "CreateGameSecurityGroup",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:vpc/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "DeleteTaggedGameInstanceAndSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:instance/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}",
          "ec2:ResourceTag/Project": "dutch-blitz"
        }
      }
    },
    {
      "Sid": "ManageRulesOnTaggedGameSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress"
      ],
      "Resource": "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}",
          "ec2:ResourceTag/Project": "dutch-blitz"
        }
      }
    },
    {
      "Sid": "TagGameNightResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": [
        "arn:aws:ec2:${aws_region}:${aws_account_id}:instance/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:volume/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:security-group/*",
        "arn:aws:ec2:${aws_region}:${aws_account_id}:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${aws_region}"
        }
      }
    },
    {
      "Sid": "ReadGameInstanceProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::${aws_account_id}:instance-profile/${role_name}"
    },
    {
      "Sid": "PassGameRoleToEc2Only",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${aws_account_id}:role/${role_name}",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ChangeOnlyBlitzARecord",
      "Effect": "Allow",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/${dns_zone_id}",
      "Condition": {
        "ForAllValues:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "${dns_record_name}.*"
          ]
        },
        "ForAllValues:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "A"
          ],
          "route53:ChangeResourceRecordSetsActions": [
            "CREATE",
            "UPSERT",
            "DELETE"
          ]
        }
      }
    },
    {
      "Sid": "DenyClerkAndMailRecordChanges",
      "Effect": "Deny",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/${dns_zone_id}",
      "Condition": {
        "ForAnyValue:StringLike": {
          "route53:ChangeResourceRecordSetsNormalizedRecordNames": [
            "clerk.*",
            "accounts.*",
            "clkmail.*",
            "clk._domainkey.*",
            "clk2._domainkey.*"
          ]
        }
      }
    },
    {
      "Sid": "DenyZoneDelegationAndCnameChanges",
      "Effect": "Deny",
      "Action": "route53:ChangeResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/${dns_zone_id}",
      "Condition": {
        "ForAnyValue:StringEquals": {
          "route53:ChangeResourceRecordSetsRecordTypes": [
            "NS",
            "SOA",
            "CNAME"
          ]
        }
      }
    },
    {
      "Sid": "ReadGameHostedZone",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:ListResourceRecordSets",
        "route53:ListTagsForResource"
      ],
      "Resource": "arn:aws:route53:::hostedzone/${dns_zone_id}"
    },
    {
      "Sid": "ListHostedZonesByName",
      "Effect": "Allow",
      "Action": [
        "route53:ListHostedZones",
        "route53:ListHostedZonesByName"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PollRoute53ChangeStatus",
      "Effect": "Allow",
      "Action": "route53:GetChange",
      "Resource": "arn:aws:route53:::change/*"
    },
    {
      "Sid": "ReadAndWriteBackupObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${backup_bucket_name}/*"
    },
    {
      "Sid": "ManageBackupBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:GetBucketVersioning",
        "s3:PutBucketVersioning",
        "s3:GetEncryptionConfiguration",
        "s3:PutEncryptionConfiguration",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": [
        "arn:aws:s3:::${backup_bucket_name}",
        "arn:aws:s3:::${backup_bucket_name}/*"
      ]
    },
    {
      "Sid": "ReadBackupBucketConfiguration",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketPolicy",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketWebsite",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketLogging",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketOwnershipControls"
      ],
      "Resource": "arn:aws:s3:::${backup_bucket_name}"
    },
    {
      "Sid": "ReadWriteGameNightState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${state_bucket_name}/dutch-blitz/game-night/terraform.tfstate",
        "arn:aws:s3:::${state_bucket_name}/dutch-blitz/backup/terraform.tfstate"
      ]
    },
    {
      "Sid": "LockGameNightState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::${state_bucket_name}/dutch-blitz/game-night/terraform.tfstate.tflock",
        "arn:aws:s3:::${state_bucket_name}/dutch-blitz/backup/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "ListStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "arn:aws:s3:::${state_bucket_name}"
    },
    {
      "Sid": "ReadCostExplorer",
      "Effect": "Allow",
      "Action": "ce:GetCostAndUsage",
      "Resource": "*"
    },
    {
      "Sid": "ViewMonthlyBudget",
      "Effect": "Allow",
      "Action": "budgets:ViewBudget",
      "Resource": "arn:aws:budgets::${aws_account_id}:budget/${budget_name}"
    }
  ]
}
