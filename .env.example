# Copy to .env and fill in real values. .env is gitignored. Do not commit keys.

DUTCH_BLITZ_DB_PATH=data/dutch_blitz.sqlite
DUTCH_BLITZ_HOST=127.0.0.1
DUTCH_BLITZ_PORT=8000

# From the Clerk dashboard: API keys. Required for sign-in.
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Optional. Derived from the publishable key when omitted.
# CLERK_FRONTEND_API=example.clerk.accounts.dev
# CLERK_ISSUER=https://example.clerk.accounts.dev
# CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json

# Optional. Comma-separated origins allowed in the token azp claim.
# CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000

# Dev only. Off by default. Never enable this on a shared or deployed server.
# CLERK_DEV_BYPASS=0
# CLERK_DEV_USER_ID=dev-user
